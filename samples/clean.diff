index 0000000..d4e5f6a
--- /dev/null
+++ b/test/retry.test.js
@@ -0,0 +1,14 @@
+const test = require('node:test')
+const assert = require('node:assert/strict')
+
+const { withRetry } = require('../lib/retry.js')
+
+test('withRetry tenta de novo e devolve o resultado', async () => {
+  let calls = 0
+  const result = await withRetry(async () => {
+    calls += 1
+    if (calls < 2) throw new Error('falhou')
+    return 'ok'
+  })
+  assert.equal(result, 'ok')
+})
