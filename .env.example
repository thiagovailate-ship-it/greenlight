# Copie para .env. O servidor e o CLI leem este arquivo automaticamente
# (sem sobrescrever variáveis que já existem no ambiente).

# ---------------------------------------------------------------- Servidor
PORT=3000
# NODE_ENV=production
# Em produção, webhooks sem assinatura são rejeitados por padrão.
# GREENLIGHT_ALLOW_UNSIGNED_WEBHOOKS=1

# ------------------------------------------------------------- GitHub App
GITHUB_APP_ID=
# Conteúdo do arquivo .pem gerado pelo GitHub App (aceita \n literais):
# GITHUB_PRIVATE_KEY="COLE_A_CHAVE_PEM_AQUI"
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub Enterprise: https://github.sua-empresa.com/api/v3
# GITHUB_API_URL=https://api.github.com
# Token com permissão de leitura, usado só pelo CLI (`gl review --pr`).
# GITHUB_TOKEN=ghp_...

# -------------------------------------------------------------------- LLM
# off | openai | anthropic | ollama — vazio detecta pelas chaves presentes.
GREENLIGHT_LLM=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------ Observações
# Limite do corpo do diff na API HTTP (bytes)
GREENLIGHT_MAX_DIFF_BYTES=524288
# Revisões por minuto, por IP
GREENLIGHT_RATE_LIMIT=40
